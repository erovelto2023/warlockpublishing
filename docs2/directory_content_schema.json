{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Generic Directory Page Content Schema",
  "description": "Reusable JSON structure for populating directory pages with keyword-specific content",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "description": "Page metadata and SEO information",
      "properties": {
        "title": {
          "type": "string",
          "description": "Page title and H1 heading",
          "example": "Discover Premium Cannabinoid Products from Binoid"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug",
          "example": "binoid-cannabinoids"
        },
        "description": {
          "type": "string",
          "description": "Meta description and hero subtitle",
          "example": "Explore a comprehensive guide to Binoid's award-winning collection of CBD, Delta 9, THCA, THCP, and more."
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Target keywords for SEO",
          "example": ["Binoid", "Delta 9 THC", "THCA", "THCP"]
        },
        "category": {
          "type": "string",
          "description": "Content category for organization",
          "example": "Cannabinoids"
        },
        "badge": {
          "type": "string",
          "description": "Hero section badge text",
          "example": "Premium Hemp-Derived Cannabinoids"
        }
      },
      "required": ["title", "slug", "description", "keywords"]
    },
    "hero": {
      "type": "object",
      "description": "Hero section configuration",
      "properties": {
        "headline": {
          "type": "string",
          "description": "Main headline"
        },
        "subheadline": {
          "type": "string",
          "description": "Supporting text below headline"
        },
        "cta_primary": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "link": { "type": "string" },
            "color": { "type": "string", "enum": ["green", "blue", "purple", "orange"] }
          }
        },
        "cta_secondary": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "link": { "type": "string" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "description": "Key features/benefits section (3-4 items)",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "enum": ["award", "zap", "shopping-cart", "leaf", "book", "video", "star", "check"],
            "description": "Icon type from lucide-react"
          },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["icon", "title", "description"]
      }
    },
    "main_sections": {
      "type": "array",
      "description": "Main content sections (e.g., Cannabinoids, Product Types, etc.)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique section ID for anchor links",
            "example": "cannabinoids"
          },
          "title": {
            "type": "string",
            "description": "Section heading"
          },
          "subtitle": {
            "type": "string",
            "description": "Section subheading"
          },
          "type": {
            "type": "string",
            "enum": ["tabs", "cards", "accordion", "list", "comparison"],
            "description": "Section layout type"
          },
          "content": {
            "type": "array",
            "description": "Section content items",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "description": { "type": "string" },
                "highlights": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": { "type": "integer" },
                      "title": { "type": "string" },
                      "description": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "required": ["id", "title", "type", "content"]
      }
    },
    "resources": {
      "type": "object",
      "description": "External resources and media",
      "properties": {
        "youtube_videos": {
          "type": "array",
          "description": "YouTube videos related to the topic",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "video_id": { "type": "string", "description": "YouTube video ID" },
              "channel": { "type": "string" },
              "duration": { "type": "string", "example": "12:34" },
              "description": { "type": "string" }
            },
            "required": ["title", "video_id"]
          }
        },
        "related_products": {
          "type": "array",
          "description": "Related products or items to showcase",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "image_url": { "type": "string" },
              "price": { "type": "string" },
              "link": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "external_links": {
          "type": "array",
          "description": "External resource links",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "description": { "type": "string" },
              "icon": { "type": "string", "enum": ["link", "book", "globe", "file"] }
            }
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "description": "Frequently Asked Questions",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        },
        "required": ["question", "answer"]
      }
    },
    "cta_section": {
      "type": "object",
      "description": "Call-to-action section at bottom",
      "properties": {
        "headline": { "type": "string" },
        "description": { "type": "string" },
        "button_text": { "type": "string" },
        "button_link": { "type": "string" },
        "background_color": { "type": "string", "enum": ["green", "blue", "purple", "orange"] }
      }
    },
    "footer_links": {
      "type": "object",
      "description": "Footer navigation and links",
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "required": ["metadata", "hero", "features", "main_sections"]
}
